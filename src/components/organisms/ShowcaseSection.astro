---
import showcase from '../../data/showcase.json';
---

<section id="showcase" class="flex flex-col px-20 max-md:p-3 gap-6">
  <h2 class="font-bold text-[2.125rem] animate-on-scroll">Showcases</h2>
  <div class="grid grid-flow-row grid-cols-3 max-xl:grid-cols-1 gap-6 py-6 items-center">
    {showcase.map((project) => (
      <a
        href={`/showcase/${project.slug}`}
        class={`showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll${project.delay ? ' delay-100' : ''}`}
      >
        <figure class="w-full h-[345px] max-sm:h-[180px]">
          <img
            loading="lazy"
            class="w-full h-full max-sm:h-[180px] object-cover object-left-top"
            src={project.image}
            alt={project.alt}
            width={project.width}
            height={project.height}
          />
        </figure>
        <div class="flex flex-col gap-3 p-3">
          <h3 class="text-xl font-bold">{project.title}</h3>
          <p class="text-lg font-semibold">{project.type}</p>
          <p class="text-sm text-ellipsis line-clamp-2">{project.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>
