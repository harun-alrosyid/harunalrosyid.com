---
---
<section id="showcase" class="flex flex-col px-20 max-md:p-3 gap-6">
      <h2 class="font-bold text-[2.125rem] animate-on-scroll">Showcases</h2>
      <div class="grid grid-flow-row grid-cols-3 max-xl:grid-cols-1 gap-6 py-6 items-center">
        <a href="/showcase/md-lite" class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll">
          <figure class="w-full h-[345px] max-sm:h-[180px]">
            <img loading="lazy" class="w-full h-full max-sm:h-[180px] object-cover object-left-top"
              src="/assets/images/portofolio/mdlite.webp" alt="MD-Lite" width="1400" height="1230" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-bold">MD-Lite</h3>
            <p class="text-lg font-semibold">Desktop Application ( Tauri + Svelte )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A hyper-lightweight, minimalist Markdown editor built for speed and focus with seamless
              WYSIWYG editing powered by Tauri and Svelte.
            </p>
          </div>
        </a>

        <a href="/showcase/markvault" class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll">
          <figure class="w-full h-[345px] max-sm:h-[180px]">
            <img loading="lazy" class="w-full h-full max-sm:h-[180px] object-cover object-left-top"
              src="/assets/images/portofolio/markvault-portfolio.webp" alt="MarkVault" width="1400" height="767" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-bold">MarkVault</h3>
            <p class="text-lg font-semibold">Web Application ( React )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              MarkVault is a professional image protection tool designed for photographers, content creators, and
              businesses who want to safeguard their visual assets with intelligent watermarking.
            </p>
          </div>
        </a>

        <a href="/showcase/nex-drive"
          class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll delay-100">
          <figure class="w-full h-[345px] max-sm:h-[180px]">
            <img loading="lazy" class="w-full h-full max-sm:h-[180px] object-cover object-left-top"
              src="/assets/showcase/nex-drive.webp" alt="porto" width="514" height="245" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-bold">Nex Drive</h3>
            <p class="text-lg font-semibold">Web Application ( React )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A web-based online storage platform similar to Google Drive or OneDrive, tailored
              for enterprise service from Nexsoft.
            </p>
          </div>
        </a>

        <a href="/showcase/senyum-mobile-end-user"
          class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll ">
          <figure class="w-full h-[345px] max-sm:h-[180px]">
            <img loading="lazy" class="w-full h-full object-cover object-left-top" src="/assets/images/portofolio/senyum.webp"
              alt="porto" width="1400" height="818" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-bold">Senyum Mobile End User</h3>
            <p class="text-lg font-semibold">Mobile App ( React Native )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A mobile application designed for ultra-micro customers (UMi) to independently
              access digital financial services including account information, location merchant
              services, and customer support.
            </p>
          </div>
        </a>

        <a href="/showcase/recruitment-hub-asia"
          class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll ">
          <figure class="w-full h-[345px] max-sm:h-[180px]">
            <img loading="lazy" class="w-full h-full object-cover object-left-top"
              src="/assets/images/portofolio/reruitmenthubasia.webp" alt="porto" width="1400" height="836" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-bold">Recruitment Hub Asia</h3>
            <p class="text-lg font-semibold">Web Application ( Wordpress )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A company profile and job portal site built on WordPress with custom database
              triggers for job listing integration.
            </p>
          </div>
        </a>

        <a href="/showcase/nex-component-ui"
          class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll delay-100">
          <figure class="w-full h-[345px]">
            <img loading="lazy" class="w-full h-[345px] object-cover object-left-top" src="/assets/showcase/nex-component-ui.webp" alt="Nex Component UI" loading="lazy" width="1400" height="1154" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-semibold">Nex Component UI</h3>
            <p class="text-lg font-semibold">Reusable UI Library ( React )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              An internal React UI component library developed for use across multiple Nexsoft
              products to ensure design consistency and reusability.
            </p>
          </div>
        </a>

        <a href="/showcase/nex-hub" class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll ">
          <figure class="w-full h-[345px]">
            <img loading="lazy" class="w-full h-[345px] object-cover object-left-top" src="/assets/images/portofolio/nexhub.webp" alt="Nex Hub" loading="lazy" width="1400" height="818" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-semibold">Nex Hub</h3>
            <p class="text-lg font-semibold">Web Application ( React )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A data mapping platform that centralizes customer, principal, and resource data for
              use across Nexsoft’s suite of applications.
            </p>
          </div>
        </a>

        <a href="/showcase/customization-engine"
          class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll ">
          <figure class="w-full h-[345px]">
            <img loading="lazy" class="w-full h-[345px] object-cover object-left-top"
              src="https://user-images.githubusercontent.com/38546311/106383423-6ad03000-63f8-11eb-9313-808e0241c0cd.PNG" alt="Customization Engine" loading="lazy" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-semibold">Customization Engine</h3>
            <p class="text-lg font-semibold">Multi-PHP Apache Server</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A customized Apache server setup capable of running multiple PHP versions
              concurrently to support legacy and modern systems.
            </p>
          </div>
        </a>

        <a href="/showcase/senyum-mobile-tenaga-pemasar"
          class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll delay-100">
          <figure class="w-full h-[345px]">
            <img loading="lazy" class="w-full h-[345px] object-cover object-left-top" src="/assets/images/portofolio/senyum.webp" alt="Senyum Mobile" loading="lazy" width="1400" height="818" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-semibold">Senyum Mobile - Tenaga Pemasar</h3>
            <p class="text-lg font-semibold">Web Application - Microsite ( React )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A web-based cross-selling service for PNM, Pengadaian and BRI products used by
              BRILink marketing agents to help promote and manage financial products and services
              offered through the Senyum platform.
            </p>
          </div>
        </a>

        <a href="/showcase/seyum-mobole-dashboard"
          class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll ">
          <figure class="w-full h-[345px]">
            <img loading="lazy" class="w-full h-[345px] object-cover object-left-top" src="/assets/images/portofolio/senyum.webp" alt="Senyum Mobile" loading="lazy" width="1400" height="818" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-semibold">Senyum Mobile - Dashboard Admin</h3>
            <p class="text-lg font-semibold">Web Application ( React - Next Js )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              A web-based admin panel designed to manage operational workflows for the Senyum
              platform, enabling backend processes such as unit pairing, identity validation, and
              customer data management across BRI, PNM, and Pegadaian.
            </p>
          </div>
        </a>

        <a href="/showcase/grorex" class="showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll ">
          <figure class="w-full h-[345px]">
            <img loading="lazy" class="w-full h-[345px] object-cover object-left-top" src="/assets/images/portofolio/grorex.jpg" alt="Grorex" loading="lazy" width="1400" height="818" />
          </figure>
          <div class="flex flex-col gap-3 p-3">
            <h3 class="text-xl font-semibold">Grorex</h3>
            <p class="text-lg font-semibold">Web Application ( React )</p>
            <p class="text-sm text-ellipsis line-clamp-2">
              An internal web application for managing a B2B lending service, providing tools for
              customer data administration, user access control, and loan processing workflows
            </p>
          </div>
        </a>
      </div>
    </section>
