---
import { resumeUrl } from '../../data/resume.ts';
import CopyrightYear from '../atoms/CopyrightYear';
---
<footer
    class="grid grid-flow-row grid-cols-1 md:grid-cols-[1fr_3fr] md:[grid-template-areas:'overview_overview'_'quick-links_cta'] lg:grid-cols-3 lg:[grid-template-areas:'overview_quick-links_cta'] gap-6 py-6 px-16 max-md:p-3 items-center">
    <div class="md:h-52 flex flex-col px-10 max-sm:px-3 gap-3 md:[grid-area:overview]">
      <p class="text-lg">
        A Web Development showcase built by Harun Al Rosyid, featuring beautiful, functional, and
        user-friendly applications
      </p>
      <div class="flex flex-row gap-3">
        <a href="https://github.com/harun-alrosyid" class="social-icon social-icon-github">
          <img loading="lazy" src="/assets/icons/github.svg" alt="github-icon" />
        </a>
        <a href="https://www.linkedin.com/in/harun-alrosyid" class="social-icon social-icon-linkedin">
          <img loading="lazy" src="/assets/icons/linkedin.svg" alt="linkedin-icon" />
        </a>
        <a href="https://t.me/harunalrosyiid" class="social-icon social-icon-telegram">
          <img loading="lazy" src="/assets/icons/telegram.svg" alt="telegram-icon" />
        </a>
      </div>
      <span class="text-base font-semibold">
        &copy; <CopyrightYear /> Harun Al Rosyid. All rights reserved.</span>
    </div>

    <div class="md:h-52 flex flex-col px-10 max-sm:px-3 gap-3 md:[grid-area:quick-links]">
      <nav class="flex flex-col gap-3 text-center max-lg:text-left">
        <h4 class="text-2xl font-semibold">Quick Links</h4>
        <ul class="list-none flex flex-col text-center max-lg:text-left text-lg">
          <li id="footer_navbar-item-home"><a class="footer-link" href="/">Home</a></li>
          <li id="footer_navbar-item-journey">
            <a class="footer-link" href="/journey">Journey</a>
          </li>
          <li id="footer_navbar-item-showcase">
            <a class="footer-link" href="/showcase">Showcase</a>
          </li>
          <li id="footer_navbar-item-collaborate">
            <a class="footer-link" href="/collaborate">Collaborate</a>
          </li>
          {resumeUrl && (
            <li id="footer_navbar-item-resume">
              <a class="footer-link" href={resumeUrl}
              target="_blank">Resume</a>
            </li>
          )}
        </ul>
      </nav>
    </div>

    <div class="md:h-52 flex flex-col px-10 max-sm:px-3 gap-3 md:[grid-area:cta]">
      <h4 class="text-2xl font-semibold">Get In Touch</h4>
      <p class="text-lg">
        Have a project in mind or want to work together? Feel free to reach out!
      </p>
      <a href="/collaborate" class="footer-cta w-fit bg-gray-04 p-3 rounded-lg font-bold text-lg">
        Collaborate with me
      </a>
    </div>
  </footer>
