---
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import SkillsSection from '../components/organisms/SkillsSection.astro';
import showcase from '../data/showcase.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Harun Al Rosyid | Software Developer | Showcase</title>
    <meta name="title" content="Showcase - Harun Al Rosyid - Software Developer" />
    <meta
      name="description"
      content="Browse the project showcase of Harun Al Rosyid. A curated portfolio of web & mobile applications built with React, React Native, and Next.js."
    />
    <meta
      name="keywords"
      content="Harun Al Rosyid, Software Developer, Frontend Developer, React, React Native, Next.js, Tailwind, Indonesia Developer"
    />
    <meta name="author" content="Harun Al Rosyid" />
    <link rel="canonical" href="https://harunalrosyid.com/showcase" />
    <meta name="image" content="https://harunalrosyid.com/assets/images/preview.jpg" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://harunalrosyid.com/showcase" />
    <meta property="twitter:title" content="Project Showcase - Harun Al Rosyid" />
    <meta
      property="twitter:description"
      content="Project showcase by Harun Al Rosyid — web & mobile apps built with modern technologies."
    />
    <meta property="twitter:image" content="https://harunalrosyid.com/assets/images/preview.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://harunalrosyid.com/showcase" />
    <meta property="og:title" content="Project Showcase - Harun Al Rosyid" />
    <meta
      property="og:description"
      content="Explore a curated portfolio of web & mobile apps built by Harun Al Rosyid."
    />
    <meta property="og:image" content="https://harunalrosyid.com/assets/images/preview.jpg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LSYPC48GC6"></script>
    <script src="/assets/js/analytics.js" defer></script>
    <link rel="icon" href="/favicon-32.png" type="image/x-icon" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/images/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="Harun Al Rosyid" />
    <meta name="apple-mobile-web-app-title" content="Harun Al Rosyid" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Project Showcase - Harun Al Rosyid",
        "description": "A curated portfolio of web & mobile applications built by Harun Al Rosyid.",
        "url": "https://harunalrosyid.com/showcase",
        "creator": { "@type": "Person", "name": "Harun Al Rosyid" }
      }
    </script>
    <link rel="stylesheet" href="/output.css" />
    <script src="/assets/js/scroll-animations.js" defer></script>
    <script is:inline src="/assets/js/theme-toggle.js"></script>
  </head>

  <body class="showcase-page bg-dark text-light p-6">
    <Header />
    <main>
      <section id="intro" class="flex flex-col px-20 py-32 gap-6 max-md:p-3 animate-on-scroll">
        <h1 class="font-bold text-[2.125rem]">Showcase</h1>
        <p class="text-2xl">
          With a diverse skill set and experience across multiple technologies, I deliver
          comprehensive solutions for modern web and mobile applications.
        </p>
        <div class="flex flex-row gap-3">
          <a href="https://github.com/harun-alrosyid" class="social-icon social-icon-github">
            <img loading="lazy" src="/assets/icons/github.svg" alt="github-icon" />
          </a>
          <a href="https://www.linkedin.com/in/harun-alrosyid" class="social-icon social-icon-linkedin">
            <img loading="lazy" src="/assets/icons/linkedin.svg" alt="linkedin-icon" />
          </a>
          <a href="https://t.me/harunalrosyiid" class="social-icon social-icon-telegram">
            <img loading="lazy" src="/assets/icons/telegram.svg" alt="telegram-icon" />
          </a>
        </div>
      </section>

      <section id="showcase" class="flex flex-col px-20 py-32 max-md:p-3 gap-6">
        <h2 class="font-bold text-[2.125rem] animate-on-scroll">Completed Projects</h2>
        <div class="grid grid-flow-row grid-cols-3 max-xl:grid-cols-1 gap-6 py-6 items-center">
          {showcase.map((project) => (
            <a
              href={`/showcase/${project.slug}`}
              class={`showcase-card w-full flex flex-col gap-6 bg-gray-04 animate-on-scroll${project.delay ? ' delay-100' : ''}`}
            >
              <figure class="w-full h-[345px] max-sm:h-[180px]">
                <img
                  loading="lazy"
                  class="w-full h-full max-sm:h-[180px] object-cover object-left-top"
                  src={project.image}
                  alt={project.alt}
                  width={project.width}
                  height={project.height}
                />
              </figure>
              <div class="flex flex-col gap-3 p-3">
                <h3 class="text-xl font-bold">{project.title}</h3>
                <p class="text-lg font-semibold">{project.type}</p>
                <p class="text-sm text-ellipsis line-clamp-2">{project.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
      <SkillsSection />
    </main>
    <Footer />
    <script src="/assets/js/footer-year.js" defer></script>
  </body>
</html>
